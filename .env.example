# Copy to .env.local for local development. Never commit a file with real
# values (see .ai-team/standards/development/ENVIRONMENT_CONFIGURATION.md).

# --- Firebase client config (public by Firebase's design; not a secret —
# see src/lib/firebase/client.ts and THREAT-SPT-001's "Spoofing" note) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-only, used by Next.js API routes per
# ADR-SPT-002) — the full service-account JSON as a single-line string.
# This IS a secret: local value stays in .env.local (gitignored); in
# staging/production it must come from an approved secret store, never a
# file in the deployment artifact (SECRETS_MANAGEMENT.md). ---
FIREBASE_SERVICE_ACCOUNT_KEY=
